<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.NoRushCart.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
    android:layout_marginVertical="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivSavedImage"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@color/surface_container_low"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSavedPlatform"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Amazon"
                    android:textAppearance="@style/TextAppearance.NoRushCart.LabelSm"
                    android:textColor="@color/text_tertiary" />

                <!-- Location Chip if available -->
                <LinearLayout
                    android:id="@+id/layoutSavedLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_chip_location"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvSavedLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:maxWidth="130dp"
                        android:text="📍 Trigger Spot"
                        android:textAppearance="@style/TextAppearance.NoRushCart.LabelSm"
                        android:textColor="@color/secondary_light" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvSavedTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.NoRushCart.TitleMd"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvSavedPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.NoRushCart.TitleMd"
                android:textColor="@color/status_unlocked" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
