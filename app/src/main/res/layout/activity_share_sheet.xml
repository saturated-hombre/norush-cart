<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@android:color/transparent"
    android:padding="16dp">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.NoRushCart.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/glass_sheet_bg"
        app:cardCornerRadius="@dimen/radius_card_large"
        app:strokeColor="@color/glass_border_active"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Sheet Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_privacy_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛡️  "
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/share_sheet_title"
                        android:textAppearance="@style/TextAppearance.NoRushCart.LabelMd"
                        android:textColor="@color/primary" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/btnCloseSheet"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Close"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_tertiary" />
            </LinearLayout>

            <!-- Loading Container -->
            <LinearLayout
                android:id="@+id/layoutLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ProgressBar
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:indeterminate="true"
                    android:indeterminateDrawable="@drawable/ic_norush_loading" />

                <TextView
                    android:id="@+id/tvLoadingStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/share_sheet_scraping"
                    android:textAppearance="@style/TextAppearance.NoRushCart.BodyMd"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <!-- Content Container (Shown after parse) -->
            <LinearLayout
                android:id="@+id/layoutContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Product Preview Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivProductImage"
                        android:layout_width="@dimen/product_thumb_size"
                        android:layout_height="@dimen/product_thumb_size"
                        android:background="@color/surface_container_low"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvRetailer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Amazon"
                            android:textAppearance="@style/TextAppearance.NoRushCart.LabelSm"
                            android:textColor="@color/primary" />

                        <TextView
                            android:id="@+id/tvProductTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.NoRushCart.TitleMd"
                            android:textColor="@color/text_primary" />

                        <!-- Price Display Row -->
                        <LinearLayout
                            android:id="@+id/layoutPriceView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvProductPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.NoRushCart.HeadlineMd"
                                android:textColor="@color/primary_light" />

                            <ImageView
                                android:id="@+id/btnEditPriceInline"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginStart="8dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:contentDescription="Edit Price"
                                android:focusable="true"
                                android:padding="2dp"
                                android:src="@drawable/ic_edit"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Inline Price Editor (shown when price <= 0 or user taps edit) -->
                <LinearLayout
                    android:id="@+id/layoutPriceEditInline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_dialog_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹ "
                        android:textAppearance="@style/TextAppearance.NoRushCart.TitleMd"
                        android:textColor="@color/primary" />

                    <EditText
                        android:id="@+id/etInlinePrice"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:hint="Enter price (e.g. 100000)"
                        android:inputType="numberDecimal"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveInlinePrice"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:backgroundTint="@color/primary_container"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:minWidth="0dp"
                        android:paddingHorizontal="14dp"
                        android:text="Save"
                        android:textColor="@color/primary_light"
                        android:textSize="12sp"
                        app:cornerRadius="@dimen/radius_pill" />
                </LinearLayout>

                <!-- Chips Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Lock Duration Chip -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/chip_height"
                        android:background="@drawable/bg_chip_amber"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp">

                        <TextView
                            android:id="@+id/tvLockChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔒 Locked for 48 hours"
                            android:textAppearance="@style/TextAppearance.NoRushCart.LabelSm"
                            android:textColor="@color/status_locked" />
                    </LinearLayout>

                    <!-- Location Chip -->
                    <LinearLayout
                        android:id="@+id/layoutLocationChip"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/chip_height"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_location"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvLocationChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:maxWidth="140dp"
                            android:text="📍 Trigger Geotagged"
                            android:textAppearance="@style/TextAppearance.NoRushCart.LabelSm"
                            android:textColor="@color/secondary_light" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/share_sheet_locked_subtitle"
                    android:textAppearance="@style/TextAppearance.NoRushCart.BodySm"
                    android:textColor="@color/text_secondary" />

                <!-- Got it Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_primary"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_button_gradient"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="@string/share_sheet_btn_done"
                    android:textAllCaps="false"
                    android:textColor="@color/canvas_base"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null"
                    app:cornerRadius="@dimen/radius_pill" />

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
