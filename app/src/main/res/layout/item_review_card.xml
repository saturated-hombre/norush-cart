<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.NoRushCart.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
    android:layout_marginVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Thumbnail + Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivProductImage"
                android:layout_width="@dimen/product_thumb_size"
                android:layout_height="@dimen/product_thumb_size"
                android:background="@color/surface_container_low"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPlatformBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amazon"
                    android:textAppearance="@style/TextAppearance.NoRushCart.LabelSm"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/tvProductTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.NoRushCart.TitleMd"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvProductPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.NoRushCart.TitleLg"
                    android:textColor="@color/primary_light" />

            </LinearLayout>
        </LinearLayout>

        <!-- Unlocked Status Banner & Location Chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="@dimen/chip_height"
                android:background="@drawable/bg_chip_mint"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ Ready to Decide"
                    android:textAppearance="@style/TextAppearance.NoRushCart.LabelSm"
                    android:textColor="@color/status_unlocked" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutLocationChipReview"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/chip_height"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_location"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvLocationChipReview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Trigger Spot"
                    android:textAppearance="@style/TextAppearance.NoRushCart.LabelSm"
                    android:textColor="@color/secondary_light" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvReviewMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="48-hour cooldown complete. Do you still truly want this?"
            android:textAppearance="@style/TextAppearance.NoRushCart.BodySm"
            android:textColor="@color/text_secondary" />

        <!-- Action: See it in person / Find in nearby store -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFindInStore"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="@string/btn_find_in_store"
            android:textAllCaps="false"
            android:textColor="@color/secondary_light"
            app:backgroundTint="@color/surface_container"
            app:cornerRadius="@dimen/radius_pill"
            app:strokeColor="@color/secondary"
            app:strokeWidth="1dp" />

        <!-- Actions: Discard & Save (Outlined) + Buy Now (Gradient) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDiscard"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="@string/btn_discard"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                app:cornerRadius="@dimen/radius_pill"
                app:strokeColor="@color/glass_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBuyNow"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_gradient"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="@string/btn_buy_now"
                android:textAllCaps="false"
                android:textColor="@color/canvas_base"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="@dimen/radius_pill" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>