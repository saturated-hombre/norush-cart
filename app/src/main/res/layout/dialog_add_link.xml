<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Intercept Product Link"
        android:textAppearance="@style/TextAppearance.NoRushCart.TitleLg"
        android:textColor="@color/text_primary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:text="Paste a link from Blinkit, BigBasket, Zepto, Amazon, Flipkart, Myntra, or any store:"
        android:textAppearance="@style/TextAppearance.NoRushCart.BodySm"
        android:textColor="@color/text_secondary" />

    <!-- URL Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_dialog_input"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <EditText
            android:id="@+id/etDialogUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:fontFamily="@font/plus_jakarta_sans"
            android:hint="https://... (Blinkit, Amazon, etc.)"
            android:inputType="textUri"
            android:maxLines="3"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Optional Price Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_dialog_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹ "
            android:textAppearance="@style/TextAppearance.NoRushCart.TitleMd"
            android:textColor="@color/primary" />

        <EditText
            android:id="@+id/etDialogPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:fontFamily="@font/plus_jakarta_sans"
            android:hint="Price (e.g. 100000) - optional"
            android:inputType="numberDecimal"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogSubmit"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_button_gradient"
            android:fontFamily="@font/plus_jakarta_sans"
            android:paddingHorizontal="16dp"
            android:text="Quarantine 48h"
            android:textAllCaps="false"
            android:textColor="@color/canvas_base"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="@dimen/radius_pill" />
    </LinearLayout>

</LinearLayout>
